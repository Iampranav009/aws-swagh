rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'pranavshindeji5001@gmail.com'
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /sbclInvites/{email} {
      allow create, read, update: if isAdmin();
      allow read: if signedIn() && request.auth.token.email == email;
      allow update: if signedIn()
        && request.auth.token.email == email
        && resource.data.status == 'pending'
        && request.resource.data.status == 'verified'
        && request.resource.data.email == resource.data.email
        && request.resource.data.sbclCode == resource.data.sbclCode;
      allow delete: if isAdmin();
    }

    match /sbclCodes/{code} {
      allow read, create, update, delete: if isAdmin();
    }

    match /sbclSubReferrals/{code} {
      allow read: if isAdmin() || (signedIn()
        && get(/databases/$(database)/documents/sbclProfiles/$(request.auth.uid)).data.sbclCode == resource.data.sbclCode);
      allow create: if isAdmin() || (signedIn()
        && get(/databases/$(database)/documents/sbclProfiles/$(request.auth.uid)).data.sbclCode == request.resource.data.sbclCode
        && request.resource.data.createdBy == request.auth.token.email);
      allow update, delete: if isAdmin();
    }

    match /sbclProfiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'sbcl'
        && request.resource.data.email == request.auth.token.email
        && get(/databases/$(database)/documents/sbclInvites/$(request.auth.token.email)).data.status == 'pending'
        && request.resource.data.sbclCode == get(/databases/$(database)/documents/sbclInvites/$(request.auth.token.email)).data.sbclCode;
      allow update, delete: if isAdmin();
    }
  }
}
